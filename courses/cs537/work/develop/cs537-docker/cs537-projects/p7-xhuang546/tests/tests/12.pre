#!/usr/bin/env bash
set -e

TEST_DIR="$(pwd)"
SOLN_DIR="$TEST_DIR/../solution"
ROOTFS_DIR="$TEST_DIR/tmp/test_12/rootfs"
BUILD_DIR="$TEST_DIR/tmp/test_12/build"

rm -rf "$TEST_DIR/tmp/test_12"
mkdir -p "$BUILD_DIR"

make -C "$SOLN_DIR" clean
make -C "$SOLN_DIR"

gcc -Wall -Wextra -O2 -g -static \
    -o "$BUILD_DIR/mkdir_probe" \
    "$TEST_DIR/tests/mkdir_probe.c"

"$TEST_DIR/rootfs/make-rootfs.sh" \
    "$ROOTFS_DIR" \
    /bin/ls /bin/sh /bin/mkdir

cp -f "$BUILD_DIR/mkdir_probe" "$ROOTFS_DIR/bin/mkdir_probe"

gcc -Wall -Wextra -O2 -g \
    -I"$SOLN_DIR" \
    -o "$BUILD_DIR/test_seccomp_allow" \
    "$TEST_DIR/tests/test_seccomp_allow.c" \
    "$SOLN_DIR/container.o"
